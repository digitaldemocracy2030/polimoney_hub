# Supabase settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Ledger 専用の同期 API キー（/api/v1/sync/*）。Ledger の HUB_API_KEY_PROD / HUB_API_KEY_DEV と同じ値にする
# 未設定だと同期 API は 503 を返す。DEV キーで送られたデータは常に is_test=true になる
LEDGER_SYNC_API_KEY_PROD=
LEDGER_SYNC_API_KEY_DEV=

# Application settings
ENV=development
DEBUG=True

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS settings (for production, restrict these)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
